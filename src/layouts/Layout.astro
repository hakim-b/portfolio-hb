---
import "~/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hakim Bouabdellah",
  description = "Computer Science student at Concordia University. Full-stack developer intern based in Laval, QC.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="night" class="m-0 overflow-x-hidden scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script
      is:inline
      src="https://cdn.botpress.cloud/webchat/v3.7/inject.js"
    ></script>
    <script
      is:inline
      src="https://files.bpcontent.cloud/2026/09/16/02/20260916023959-EY9BUM6E.js"
      defer
    ></script>
  </head>
  <body class="m-0 bg-black text-base-content">
    <slot />
  </body>
</html>
